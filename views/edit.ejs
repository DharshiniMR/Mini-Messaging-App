<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Text</title>
</head>
<body>
    <h2>Edit your Chat</h2>
    <form action="/chats/<%=chat._id%>?_method=PUT" method="post">
        <h3>From :<%=chat.from%></h3>
        <textarea name="newMsg" ><%=chat.msg%></textarea>
        <h3>Received By:<%=chat.to%></h3>
        <button>Save Changes</button>
    </form>
    
</body>
</html>